{
  "$schema": "../../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "micromatrix agent",
  "version": "0.5.30",
  "identifier": "org.micromatrix.pi-mcp",
  "build": {
    "frontendDist": "../web/dist",
    "devUrl": "http://127.0.0.1:5173",
    "beforeDevCommand": "npm run dev:desktop",
    "beforeBuildCommand": "npm run build:web"
  },
  "app": {
    "windows": [
      {
        "title": "micromatrix agent",
        "width": 1180,
        "height": 780,
        "minWidth": 960,
        "minHeight": 680,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' http://127.0.0.1:8233 http://localhost:8233; img-src 'self' asset: data:; style-src 'self' 'unsafe-inline'; script-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "externalBin": [
      "binaries/micromatrix-service",
      "binaries/cloudflared"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    },
    "macOS": {
      "entitlements": "Entitlements.plist"
    },
    "resources": {
      "resources/notices/": "notices/",
      "resources/automation/": "automation/"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "android": {
      "debugApplicationIdSuffix": ".debug"
    },
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEI2RkQzNzIzNDdENkI4QUQKUldTdHVOWkhJemY5dHVUUWs5UHN5QVMycVExZEoySXNhSnl6cm1lYmUrSUcwVDQyYVhROWN0UlAK",
      "endpoints": [
        "https://github.com/HideInMatrix/micromatrix-workbench/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "quiet"
      },
      "requireSignedVersion": true
    }
  }
}
