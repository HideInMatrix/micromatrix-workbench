{
  "name": "micromatrix-pi-agent-mcp",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "npm@11",
  "engines": {
    "node": ">=22.19.0"
  },
  "workspaces": [
    "apps/*",
    "packages/*",
    "plugins/*"
  ],
  "scripts": {
    "build": "tsc -b && npm run build:web",
    "clean": "tsc -b --clean",
    "dev": "node --env-file-if-exists=.env.local --import tsx apps/daemon/src/main.ts",
    "dev:web": "vite --config apps/web/vite.config.ts",
    "dev:desktop": "node scripts/dev-desktop.mjs",
    "build:web": "vite build --config apps/web/vite.config.ts",
    "build:service": "node scripts/build-service.mjs",
    "build:sidecar": "node scripts/build-sidecar.mjs",
    "smoke:sidecar": "node scripts/smoke-sidecar.mjs",
    "check:sidecar": "npm run build:sidecar && npm run smoke:sidecar",
    "tauri": "tauri",
    "tauri:dev": "tauri dev",
    "tauri:build": "npm run build:sidecar && tauri build",
    "start": "node apps/daemon/dist/main.js",
    "test": "vitest run packages plugins apps/daemon && node --test apps/web/tests/*.test.ts scripts/tests/*.test.mjs",
    "typecheck": "tsc -b --pretty false",
    "check": "npm run typecheck && npm test && npm run build:web"
  },
  "dependencies": {
    "@earendil-works/pi-agent-core": "0.87.1",
    "@earendil-works/pi-coding-agent": "0.87.1",
    "@modelcontextprotocol/sdk": "1.30.1"
  },
  "devDependencies": {
    "@types/node": "25.0.0",
    "@tauri-apps/cli": "2.12.0",
    "esbuild": "0.28.2",
    "postject": "1.0.0-alpha.6",
    "tsx": "4.20.6",
    "typescript": "7.0.2",
    "vite": "8.3.1",
    "vitest": "4.1.11"
  }
}
