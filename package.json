{
  "name": "micromatrix-pi-agent-mcp",
  "version": "0.5.28",
  "private": true,
  "type": "module",
  "packageManager": "npm@11",
  "engines": {
    "node": ">=22.19.0"
  },
  "workspaces": [
    "apps/*",
    "packages/*",
    "plugins/*"
  ],
  "scripts": {
    "build": "tsc -b && npm run build:web",
    "clean": "tsc -b --clean",
    "dev": "node --env-file-if-exists=.env.local --import tsx apps/daemon/src/main.ts",
    "dev:web": "vite --config apps/web/vite.config.ts",
    "dev:desktop": "node scripts/dev-desktop.mjs",
    "build:web": "vite build --config apps/web/vite.config.ts",
    "build:service": "node scripts/build-service.mjs",
    "build:sidecar": "node scripts/build-sidecar.mjs",
    "asil": "npm run typecheck && node scripts/asil.mjs",
    "tauri": "node scripts/tauri.mjs",
    "tauri:dev": "npm run prepare:version && npm run tauri -- dev",
    "tauri:build": "node scripts/build-desktop.mjs",
    "start": "node apps/daemon/dist/main.js",
    "typecheck": "tsc -b --pretty false",
    "typecheck:web": "node scripts/check-web-types.mjs -p apps/web/tsconfig.sfc.json --pretty false",
    "check": "npm run typecheck && npm run typecheck:web && npm run build:web",
    "prepare:version": "node scripts/release-version.mjs",
    "prepare:computer-use": "node scripts/prepare-computer-use.mjs",
    "dev:computer-use": "node --import tsx apps/daemon/src/main.ts --computer-use-mcp",
    "notices": "node scripts/dependency-notices.mjs"
  },
  "dependencies": {
    "@earendil-works/pi-agent-core": "0.87.1",
    "@earendil-works/pi-coding-agent": "0.87.1",
    "@modelcontextprotocol/sdk": "1.32.1"
  },
  "devDependencies": {
    "@tauri-apps/cli": "2.12.0",
    "@types/node": "25.0.0",
    "esbuild": "0.28.2",
    "postject": "1.0.0-alpha.6",
    "tsx": "4.20.6",
    "typescript": "7.0.2",
    "typescript-sfc": "npm:typescript@6.0.2",
    "vite": "8.3.1",
    "vue-tsc": "3.3.12"
  },
  "overrides": {
    "source-map-js": "1.2.2"
  }
}
