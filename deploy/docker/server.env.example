# Docker 默认由宿主机 Nginx/Caddy 提供 HTTPS，并反向代理到 127.0.0.1:8234。
AGENT_RUNTIME_OAUTH_PASSWORD="替换为至少 32 字符的强随机密码"
AGENT_RUNTIME_NETWORK_PROVIDER="external"
AGENT_RUNTIME_SERVER_URL="https://mcp.example.com"

AGENT_RUNTIME_PERMISSION_MODE="safe"
AGENT_RUNTIME_ALLOW_NETWORK="0"
AGENT_RUNTIME_ENABLE_VIEW_IMAGE="1"

# 默认镜像采用容器边界、只读根文件系统、cap_drop 和 no-new-privileges。
# 不在容器内强制嵌套 bubblewrap；需要自定义镜像和运行时能力时再改为 require。
AGENT_RUNTIME_OS_SANDBOX="auto"

# AGENT_RUNTIME_ALLOWED_ORIGINS="https://trusted-client.example.com"
