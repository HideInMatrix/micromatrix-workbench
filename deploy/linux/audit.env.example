# 审计服务应使用与普通 Workspace 服务不同的域名、端口、密码和 OAuth 状态。
AGENT_RUNTIME_OAUTH_PASSWORD="替换为至少 32 字符的独立强随机密码"
AGENT_RUNTIME_NETWORK_PROVIDER="external"
AGENT_RUNTIME_SERVER_URL="https://audit-mcp.example.com"

AGENT_RUNTIME_PERMISSION_MODE="safe"
AGENT_RUNTIME_ALLOW_NETWORK="0"
AGENT_RUNTIME_ENABLE_VIEW_IMAGE="0"
AGENT_RUNTIME_OS_SANDBOX="require"

# 审计端点通常只供一个受信任客户端使用，可在确认其 Origin 后启用精确限制。
# AGENT_RUNTIME_ALLOWED_ORIGINS="https://trusted-client.example.com"
