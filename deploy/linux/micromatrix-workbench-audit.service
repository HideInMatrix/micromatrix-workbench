[Unit]
Description=MicroMatrix Workbench Read-Only Host Security Audit
Documentation=file:/opt/micromatrix-workbench/docs/SERVER_DEPLOYMENT.md
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=micromatrix
Group=micromatrix
WorkingDirectory=/opt/micromatrix-workbench
Environment=HOME=/var/lib/micromatrix-workbench-audit
Environment=PYTHONUNBUFFERED=1
Environment=PATH=/opt/micromatrix-workbench/.venv/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin

ExecStartPre=/opt/micromatrix-workbench/.venv/bin/python /opt/micromatrix-workbench/start.py /srv/micromatrix-audit --host 127.0.0.1 --port 8235 --env-file /etc/micromatrix-workbench/audit.env --check-config
ExecStart=/opt/micromatrix-workbench/.venv/bin/python /opt/micromatrix-workbench/start.py /srv/micromatrix-audit --host 127.0.0.1 --port 8235 --env-file /etc/micromatrix-workbench/audit.env

Restart=on-failure
RestartSec=5s
TimeoutStartSec=90s
TimeoutStopSec=20s
KillSignal=SIGTERM
UMask=0077

StateDirectory=micromatrix-workbench-audit
StateDirectoryMode=0700
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/srv/micromatrix-audit/reports

# Curated read-only host view. Deliberately excluded: /etc/shadow, /root,
# private SSH/TLS keys, process environments, Docker socket and container roots.
BindReadOnlyPaths=-/etc/os-release:/srv/micromatrix-audit/host/etc/os-release
BindReadOnlyPaths=-/etc/debian_version:/srv/micromatrix-audit/host/etc/debian_version
BindReadOnlyPaths=-/etc/passwd:/srv/micromatrix-audit/host/etc/passwd
BindReadOnlyPaths=-/etc/group:/srv/micromatrix-audit/host/etc/group
BindReadOnlyPaths=-/etc/fstab:/srv/micromatrix-audit/host/etc/fstab
BindReadOnlyPaths=-/etc/hostname:/srv/micromatrix-audit/host/etc/hostname
BindReadOnlyPaths=-/etc/hosts:/srv/micromatrix-audit/host/etc/hosts
BindReadOnlyPaths=-/etc/resolv.conf:/srv/micromatrix-audit/host/etc/resolv.conf
BindReadOnlyPaths=-/etc/sysctl.conf:/srv/micromatrix-audit/host/etc/sysctl.conf
BindReadOnlyPaths=-/etc/sysctl.d:/srv/micromatrix-audit/host/etc/sysctl.d
BindReadOnlyPaths=-/etc/security:/srv/micromatrix-audit/host/etc/security
BindReadOnlyPaths=-/etc/pam.d:/srv/micromatrix-audit/host/etc/pam.d
BindReadOnlyPaths=-/etc/sudoers:/srv/micromatrix-audit/host/etc/sudoers
BindReadOnlyPaths=-/etc/sudoers.d:/srv/micromatrix-audit/host/etc/sudoers.d
BindReadOnlyPaths=-/etc/ssh/sshd_config:/srv/micromatrix-audit/host/etc/ssh/sshd_config
BindReadOnlyPaths=-/etc/ssh/sshd_config.d:/srv/micromatrix-audit/host/etc/ssh/sshd_config.d
BindReadOnlyPaths=-/etc/systemd/system:/srv/micromatrix-audit/host/etc/systemd/system
BindReadOnlyPaths=-/usr/lib/systemd/system:/srv/micromatrix-audit/host/usr/lib/systemd/system
BindReadOnlyPaths=-/lib/systemd/system:/srv/micromatrix-audit/host/lib/systemd/system
BindReadOnlyPaths=-/etc/nginx:/srv/micromatrix-audit/host/etc/nginx
BindReadOnlyPaths=-/etc/apache2:/srv/micromatrix-audit/host/etc/apache2
BindReadOnlyPaths=-/etc/caddy:/srv/micromatrix-audit/host/etc/caddy
BindReadOnlyPaths=-/etc/docker:/srv/micromatrix-audit/host/etc/docker
BindReadOnlyPaths=-/etc/containerd:/srv/micromatrix-audit/host/etc/containerd
BindReadOnlyPaths=-/etc/ufw:/srv/micromatrix-audit/host/etc/ufw
BindReadOnlyPaths=-/etc/firewalld:/srv/micromatrix-audit/host/etc/firewalld
BindReadOnlyPaths=-/etc/fail2ban:/srv/micromatrix-audit/host/etc/fail2ban
BindReadOnlyPaths=-/etc/cron.d:/srv/micromatrix-audit/host/etc/cron.d
BindReadOnlyPaths=-/proc/sys:/srv/micromatrix-audit/host/proc/sys
BindReadOnlyPaths=-/proc/mounts:/srv/micromatrix-audit/host/proc/mounts
BindReadOnlyPaths=-/proc/version:/srv/micromatrix-audit/host/proc/version
BindReadOnlyPaths=-/proc/cpuinfo:/srv/micromatrix-audit/host/proc/cpuinfo
BindReadOnlyPaths=-/proc/meminfo:/srv/micromatrix-audit/host/proc/meminfo
BindReadOnlyPaths=-/proc/net:/srv/micromatrix-audit/host/proc/net
BindReadOnlyPaths=-/sys/module:/srv/micromatrix-audit/host/sys/module
BindReadOnlyPaths=-/sys/fs/cgroup:/srv/micromatrix-audit/host/sys/fs/cgroup
BindReadOnlyPaths=-/var/log/auth.log:/srv/micromatrix-audit/host/var/log/auth.log
BindReadOnlyPaths=-/var/log/secure:/srv/micromatrix-audit/host/var/log/secure
BindReadOnlyPaths=-/var/log/kern.log:/srv/micromatrix-audit/host/var/log/kern.log
BindReadOnlyPaths=-/var/log/audit:/srv/micromatrix-audit/host/var/log/audit
BindReadOnlyPaths=-/var/log/journal:/srv/micromatrix-audit/host/var/log/journal
BindReadOnlyPaths=-/run/log/journal:/srv/micromatrix-audit/host/run/log/journal

ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
ProtectClock=true
RestrictSUIDSGID=true
RestrictRealtime=true
LockPersonality=true
CapabilityBoundingSet=
AmbientCapabilities=
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
SystemCallArchitectures=native

[Install]
WantedBy=multi-user.target
