MICROMATRIX_NAME="Pi MCP Runtime"
MICROMATRIX_WORKSPACE="."
MICROMATRIX_HOST="127.0.0.1"
MICROMATRIX_PORT="8234"
# Runtime starts only when the user clicks Start in the UI.

# Optional: override the persisted UI configuration path.
# MICROMATRIX_CONFIG_FILE="/absolute/path/runtime.json"

# OAuth is recommended for browser MCP clients. The static bearer token is a
# compatibility fallback; a public tunnel requires at least one of them.
MICROMATRIX_OAUTH_PASSWORD=""
MICROMATRIX_AUTH_TOKEN=""
MICROMATRIX_REMEMBER_SECRETS="false"

# safe | trusted | dangerous
MICROMATRIX_PERMISSION_MODE="safe"
MICROMATRIX_ENABLE_SHELL="false"

# external | cloudflare | ngrok | frp | tailscale
MICROMATRIX_NETWORK_PROVIDER="external"
MICROMATRIX_PUBLIC_URL="http://127.0.0.1:8234"

# Shared executable override. Typical values: cloudflared, ngrok, frpc, tailscale.
MICROMATRIX_TUNNEL_EXECUTABLE=""

# Cloudflare Named Tunnel. Leave URL and token empty for Quick Tunnel.
MICROMATRIX_TUNNEL_TOKEN=""

# ngrok
MICROMATRIX_NGROK_AUTH_TOKEN=""

# FRP: existing frpc TOML/INI file. Also set MICROMATRIX_PUBLIC_URL.
MICROMATRIX_FRP_CONFIG=""
