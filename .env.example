MICROMATRIX_WORKSPACE="."
MICROMATRIX_HOST="127.0.0.1"
MICROMATRIX_PORT="8234"
MICROMATRIX_AUTH_TOKEN="replace-with-a-long-random-token"

# external | cloudflare
MICROMATRIX_NETWORK_PROVIDER="external"
MICROMATRIX_PUBLIC_URL="http://127.0.0.1:8234"

# Cloudflare Quick Tunnel: leave URL and token empty.
# Cloudflare Named Tunnel: set both URL and token.
MICROMATRIX_CLOUDFLARED="cloudflared"
MICROMATRIX_TUNNEL_TOKEN=""

# Disabled by default. Set true only for a trusted workspace.
MICROMATRIX_ENABLE_SHELL="false"
